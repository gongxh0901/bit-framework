{
  "name": "@gongxh/bit-framework",
  "version": "0.5.4",
  "private": true,
  "description": "bit-framework monorepo - Cocos Creator 游戏框架",
  "scripts": {
    "clean": "pnpm -r --parallel --filter='!@gongxh/fairygui-cc' clean",
    "build": "pnpm -r build",
    "build:fgui": "pnpm --filter @gongxh/fairygui-cc build",
    "build:core": "pnpm --filter @gongxh/bit-core build",
    "build:ui": "pnpm --filter @gongxh/bit-ui build",
    "build:ecs": "pnpm --filter @gongxh/bit-ecs build",
    "build:event": "pnpm --filter @gongxh/bit-event build",
    "build:net": "pnpm --filter @gongxh/bit-net build",
    "build:quadtree": "pnpm --filter @gongxh/bit-quadtree build",
    "build:assets": "pnpm --filter @gongxh/bit-assets build",
    "build:behaviortree": "pnpm --filter @gongxh/bit-behaviortree build",
    "build:ec": "pnpm --filter @gongxh/bit-ec build",
    "build:condition": "pnpm --filter @gongxh/bit-condition build",
    "build:minigame": "pnpm --filter @gongxh/bit-minigame build",
    "build:hotupdate": "pnpm --filter @gongxh/bit-hotupdate build",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:gitlab": "node scripts/publish-gitlab.mjs",
    "prepare:npm": "node scripts/prepare-npm-publish.mjs",
    "version:patch": "pnpm -r exec -- npm version patch --no-git-tag-version && npm version patch --no-git-tag-version",
    "version:minor": "pnpm -r exec -- npm version minor --no-git-tag-version && npm version minor --no-git-tag-version",
    "version:major": "pnpm -r exec -- npm version major --no-git-tag-version && npm version major --no-git-tag-version"
  },
  "keywords": [
    "bit-framework",
    "cocos",
    "cocos-creator",
    "monorepo",
    "game-framework"
  ],
  "author": "bit老宫",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gongxh0901/bit-framework.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "rollup": "^4.28.1",
    "rollup-plugin-dts": "^6.1.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2"
  }
}
